# semantic_task_navigation 환경변수 예시
# 사용: cp .env.example .env  (.env는 .gitignore로 추적 제외)
# 실제 키/계정 정보는 이 파일에 쓰지 않는다.
# 모든 항목은 선택 사항이다. API 키 없이 로컬 모델만으로 동작하도록 설계할 예정이다.
# 변수 이름은 구현 단계에서 확정한다.

# --- 외부 LLM API (선택, Agent 명령 해석용) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- 로컬 Hugging Face 모델 캐시 (선택) ---
# 비워 두면 기본값 ~/.cache/huggingface 를 사용한다 (기존 Qwen3-VL / Grounding DINO 캐시 위치).
# HF_HOME=
# 오프라인 강제 (기존 캐시만 사용, 재다운로드 방지)
# HF_HUB_OFFLINE=1
